# Add your Daytona API key to enable Daytona sandbox execution.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=

# Optional Nosana-hosted Ollama endpoint. Images are described only when configured.
NOSANA_OLLAMA_URL=
NOSANA_MODEL=qwen3.5:9b

# auto uses Daytona when DAYTONA_API_KEY is set; otherwise it runs locally.
SCRAPE_BACKEND=auto
MAX_CONCURRENT_SANDBOXES=10
